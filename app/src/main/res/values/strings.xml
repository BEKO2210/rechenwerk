    <string name="h_gl_ter_1_a">Setze die Zahl für x ein und schreibe den Term neu auf.</string>
    <string name="h_gl_ter_1_b">Punkt vor Strich: erst malnehmen, dann addieren oder subtrahieren.</string>

    <string name="h_gl_lin_1_a">Was steht dem x noch im Weg?</string>
    <string name="h_gl_lin_1_b">Erst die Zahl auf die andere Seite bringen, dann durch den Faktor teilen.</string>
    <string name="h_gl_zwischenschritt">So sieht die Gleichung nach dem ersten Schritt aus: %1$s</string>

    <string name="h_gl_kla_1_a">Die Klammer steht als Ganzes mal %1$s.</string>
    <string name="h_gl_kla_1_b">Teile zuerst durch den Faktor vor der Klammer, die Klammer bleibt dabei zusammen.</string>

    <!-- Gestufte Hilfe der Klassen 9 und 10 -->
    <string name="h_ge_pyt_1_a">Skizziere das Dreieck und markiere den rechten Winkel.</string>
    <string name="h_ge_pyt_1_b">Die Hypotenuse liegt dem rechten Winkel gegenüber. Addiere die Quadrate der beiden Katheten.</string>
    <string name="h_ge_pyt_1_c">Die Summe der Quadrate ist %1$s. Davon fehlt noch die Wurzel.</string>
    <string name="h_ge_pyt_1_d">Eine Kathete ist gesucht: stelle den Satz nach ihr um und ziehe das Quadrat der bekannten Kathete ab.</string>
    <string name="h_ge_pyt_1_e">Nach dem Abziehen bleibt %1$s. Davon fehlt noch die Wurzel.</string>

    <string name="h_po_wur_1_a">Die Wurzel fragt: welche Zahl mit sich selbst malgenommen ergibt das?</string>
    <string name="h_po_wur_1_b">Geh die Quadratzahlen durch, bis du die passende findest.</string>
    <string name="h_po_wur_1_c">Sieh dir %1$s genauer an.</string>

    <string name="h_ge_str_1_a">Zeichne die beiden Strahlen und die Parallelen; halte fest, welche Strecke zu welcher gehört.</string>
    <string name="h_ge_str_1_b">Auf beiden Strahlen stehen die Abschnitte im selben Verhältnis.</string>
    <string name="h_ge_str_1_c">Der Streckfaktor zwischen beiden Parallelen ist %1$s.</string>

    <string name="h_pz_zin_1_a">Rechne Jahr für Jahr, nicht in einem Schritt.</string>
    <string name="h_pz_zin_1_b">Ohne Zinseszins bleiben die Zinsen in jedem Jahr gleich hoch.</string>
    <string name="h_pz_zin_1_c">Ein Jahr bringt %1$s Euro Zinsen.</string>
    <string name="h_pz_zin_1_d">Mit Zinseszins wird jedes Jahr das bereits gewachsene Kapital verzinst.</string>
    <string name="h_pz_zin_1_e">Der Faktor je Jahr ist %1$s.</string>

    <string name="h_gl_qua_1_a">Suche zwei Zahlen, die zusammen den Wert vor dem x und multipliziert den letzten Wert ergeben.</string>
    <string name="h_gl_qua_1_b">Die beiden Zahlen ergeben addiert %1$s und multipliziert %2$s.</string>
    <string name="h_gl_qua_1_c">Eine der beiden Lösungen ist %1$s. Die andere ist gesucht.</string>

    <string name="h_ge_koe_1_a">Halte zuerst fest, ob eine Fläche oder ein Volumen gesucht ist.</string>
    <string name="h_ge_koe_1_b">Die Fläche eines Rechtecks ist Länge mal Breite.</string>
    <string name="h_ge_koe_1_c">Rechne %1$s · %2$s.</string>
    <string name="h_ge_koe_1_d">Beim Dreieck kommt nach dem Malnehmen noch die Hälfte.</string>
    <string name="h_ge_koe_1_e">Grundseite mal Höhe ergibt %1$s. Jetzt noch halbieren.</string>
    <string name="h_ge_koe_1_f">Beim Quader werden alle drei Kanten multipliziert.</string>
    <string name="h_ge_koe_1_g">Die Grundfläche ist %1$s, es fehlt noch die Höhe.</string>
    <string name="h_ge_koe_1_h">Rechne zuerst den ganzen Quader, dann die Aussparung, dann die Differenz.</string>
    <string name="h_ge_koe_1_i">Der ganze Quader hat %1$s. Davon geht die Aussparung ab.</string>

    <string name="h_gl_lgs_1_a">Zwei Gleichungen, zwei Unbekannte: eine davon muss zuerst verschwinden.</string>
    <string name="h_gl_lgs_1_b">Bringe beide Gleichungen auf gleich viele y und subtrahiere sie voneinander.</string>
    <string name="h_gl_lgs_1_c">Nach dem Subtrahieren steht %1$sx = %2$s.</string>

    <string name="h_po_rat_1_a">Ein Bruch im Exponenten ist Wurzel und Potenz in einem.</string>
    <string name="h_po_rat_1_b">Der Nenner %1$s ist die Wurzel, der Zähler %2$s die Potenz.</string>
    <string name="h_po_rat_1_c">Die Wurzel ergibt %1$s. Jetzt kommt die Potenz.</string>

